{
  "manifest_version": 3,
  "name": "WhatsFill+IA",
  "version": "3.234.0",
  "description": "WhatsFill com IA: o fluxo decide 94% dos contatos, e a IA escreve o rascunho do resto e confere a cidade.",
  "permissions": [
    "storage",
    "power"
  ],
  "host_permissions": [
    "https://mobiliza.me/*",
    "https://hmwplthwqbscprkjxrbe.supabase.co/*",
    "https://mobiliza.app/*",
    "https://api.mobiliza.app/*",
    "https://wts-storage.s3.sa-east-1.amazonaws.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://graph.facebook.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mobiliza.me/*"
      ],
      "js": [
        "src/mob-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://mobiliza.app/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://mobiliza.app/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "src/facebook-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mobiliza.me/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/main.js",
        "src/lib/*",
        "src/panel/*",
        "src/data/*",
        "src/fluxo.html",
        "src/fluxo.js",
        "src/fluxo.css",
        "src/padrao.html",
        "src/padrao.js",
        "src/padrao.css"
      ],
      "matches": [
        "https://mobiliza.app/*"
      ]
    },
    {
      "resources": [
        "src/facebook-main.js",
        "src/lib/*",
        "src/panel/*",
        "src/data/*"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ]
    },
    {
      "resources": [
        "src/main.js",
        "src/lib/*",
        "src/panel/*",
        "src/data/*",
        "src/fluxo.html",
        "src/fluxo.js",
        "src/fluxo.css",
        "src/padrao.html",
        "src/padrao.js",
        "src/padrao.css"
      ],
      "matches": [
        "https://mobiliza.me/*"
      ]
    }
  ],
  "action": {
    "default_title": "WhatsFill+IA — mostrar/esconder o painel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
