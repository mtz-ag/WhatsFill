{
  "manifest_version": 3,
  "name": "WhatsFill",
  "version": "0.6.2",
  "description": "Respostas prontas, variáveis e classificação em 1 clique para o atendimento no mobiliza.app.",
  "permissions": ["storage", "power"],
  "host_permissions": [
    "https://mobiliza.app/*",
    "https://api.mobiliza.app/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mobiliza.app/*"],
      "js": ["src/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://mobiliza.app/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/main.js", "src/lib/*", "src/panel/*", "src/data/*"],
      "matches": ["https://mobiliza.app/*"]
    }
  ],
  "action": {
    "default_title": "WhatsFill — mostrar/esconder o painel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
